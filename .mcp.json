{
  "mcpServers": {
    "devai": {
      "command": "/home/snaven10/.local/share/devai/bin/devai",
      "args": [
        "server",
        "mcp"
      ],
      "env": {
        "DEVAI_STATE_DIR": "/home/snaven10/personal/modelofb/.devai/state",
        "DEVAI_LOCAL_DB_PATH": "/home/snaven10/personal/modelofb/.devai/state/vectors",
        "DEVAI_EMBEDDING_MODEL": "ml-granite",
        "DEVAI_RERANK_PROVIDER": "flashrank",
        "DEVAI_RERANK_MODEL": "ms-marco-MultiBERT-L-12",
        "DEVAI_RERANK_CACHE_DIR": "/home/snaven10/.local/share/devai/flashrank",
        "DEVAI_TOKEN_STRATEGY": "summarize",
        "DEVAI_MAX_OUTPUT_TOKENS": "8000",
        "DEVAI_SUMMARIZER_PROVIDER": "extractive"
      }
    },
    "sequentialthinking": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-sequential-thinking"]
    }
  }
}